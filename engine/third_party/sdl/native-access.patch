+/*
+ * Native access (a patch for The Dark Knight Rises reimplementation, not in upstream SDL):
+ * the backend's own objects, for libraries that record their own work into SDL's command
+ * buffers (NVIDIA DLSS on Vulkan, Apple MetalFX).
+ *
+ * SDL_GetGPUDeviceProperties also holds, with the Vulkan backend: the VkInstance,
+ * VkPhysicalDevice, VkDevice and VkQueue (pointers) and the queue family index; with the
+ * Metal backend: the id<MTLDevice> and id<MTLCommandQueue> (unretained pointers).
+ */
+#define SDL_PROP_GPU_DEVICE_VULKAN_INSTANCE_POINTER            "SDL.gpu.device.vulkan.instance"
+#define SDL_PROP_GPU_DEVICE_VULKAN_PHYSICAL_DEVICE_POINTER     "SDL.gpu.device.vulkan.physical_device"
+#define SDL_PROP_GPU_DEVICE_VULKAN_DEVICE_POINTER              "SDL.gpu.device.vulkan.device"
+#define SDL_PROP_GPU_DEVICE_VULKAN_QUEUE_POINTER               "SDL.gpu.device.vulkan.queue"
+#define SDL_PROP_GPU_DEVICE_VULKAN_QUEUE_FAMILY_INDEX_NUMBER   "SDL.gpu.device.vulkan.queue_family_index"
+#define SDL_PROP_GPU_DEVICE_METAL_DEVICE_POINTER               "SDL.gpu.device.metal.device"
+#define SDL_PROP_GPU_DEVICE_METAL_COMMAND_QUEUE_POINTER        "SDL.gpu.device.metal.command_queue"
+
+/**
+ * The backend's own texture behind an SDL GPU texture (its current one; cycling changes it).
+ *
+ * Vulkan: `*image` a VkImage, `*view` its VkImageView of every level and layer,
+ * `*native_format` its VkFormat. Metal: `*image` an unretained id<MTLTexture>, `*view` NULL,
+ * `*native_format` its MTLPixelFormat. Any output pointer may be NULL.
+ *
+ * \returns true on success, false on a backend without native access (call SDL_GetError()).
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_GetGPUNativeTexture(
+    SDL_GPUDevice *device,
+    SDL_GPUTexture *texture,
+    void **image,
+    void **view,
+    Uint32 *native_format);
+
+/**
+ * The backend's own command buffer: a VkCommandBuffer (Vulkan) or an unretained
+ * id<MTLCommandBuffer> (Metal); NULL elsewhere. Native work may be recorded into it only
+ * between SDL_BeginGPUNativeAccess and SDL_EndGPUNativeAccess.
+ */
+extern SDL_DECLSPEC void * SDLCALL SDL_GetGPUNativeCommandBuffer(SDL_GPUCommandBuffer *command_buffer);
+
+/**
+ * Hands textures to native work recorded into the command buffer, outside any pass: with
+ * Vulkan, `read` textures (created with SDL_GPU_TEXTUREUSAGE_SAMPLER) are made available in
+ * VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL and `write` ones (created with a compute storage
+ * write usage) in VK_IMAGE_LAYOUT_GENERAL, after all earlier work. The native work must
+ * leave them in those layouts. With Metal nothing needs doing (Metal tracks the hazards).
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_BeginGPUNativeAccess(
+    SDL_GPUCommandBuffer *command_buffer,
+    SDL_GPUTexture *const *read,
+    Uint32 num_read,
+    SDL_GPUTexture *const *write,
+    Uint32 num_write);
+
+/**
+ * Returns the textures of SDL_BeginGPUNativeAccess (the same lists) to SDL, after the native
+ * work.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_EndGPUNativeAccess(
+    SDL_GPUCommandBuffer *command_buffer,
+    SDL_GPUTexture *const *read,
+    Uint32 num_read,
+    SDL_GPUTexture *const *write,
+    Uint32 num_write);
+
 
