+// Native access (TDKR patch)
+
+bool SDL_GetGPUNativeTexture(SDL_GPUDevice *device, SDL_GPUTexture *texture, void **image, void **view, Uint32 *native_format)
+{
+    CHECK_DEVICE_MAGIC(device, false);
+    if (texture == NULL) {
+        return SDL_InvalidParamError("texture");
+    }
+    if (!device->GetNativeTexture) {
+        return SDL_Unsupported();
+    }
+    return device->GetNativeTexture(device->driverData, texture, image, view, native_format);
+}
+
+void *SDL_GetGPUNativeCommandBuffer(SDL_GPUCommandBuffer *command_buffer)
+{
+    if (command_buffer == NULL) {
+        SDL_InvalidParamError("command_buffer");
+        return NULL;
+    }
+    SDL_GPUDevice *device = COMMAND_BUFFER_DEVICE;
+    if (!device->GetNativeCommandBuffer) {
+        SDL_Unsupported();
+        return NULL;
+    }
+    return device->GetNativeCommandBuffer(command_buffer);
+}
+
+static bool SDL_GPUNativeAccess(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTexture *const *read, Uint32 num_read,
+                                SDL_GPUTexture *const *write, Uint32 num_write, bool begin)
+{
+    if (command_buffer == NULL) {
+        return SDL_InvalidParamError("command_buffer");
+    }
+    if ((num_read && !read) || (num_write && !write)) {
+        return SDL_InvalidParamError(num_read && !read ? "read" : "write");
+    }
+    SDL_GPUDevice *device = COMMAND_BUFFER_DEVICE;
+    if (device->debug_mode) {
+        CHECK_COMMAND_BUFFER_RETURN_FALSE
+        CHECK_ANY_PASS_IN_PROGRESS("Cannot hand textures to native work during a pass!", false)
+    }
+    if (!device->NativeAccess) {
+        return SDL_Unsupported();
+    }
+    return device->NativeAccess(command_buffer, read, num_read, write, num_write, begin);
+}
+
+bool SDL_BeginGPUNativeAccess(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTexture *const *read, Uint32 num_read,
+                              SDL_GPUTexture *const *write, Uint32 num_write)
+{
+    return SDL_GPUNativeAccess(command_buffer, read, num_read, write, num_write, true);
+}
+
+bool SDL_EndGPUNativeAccess(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTexture *const *read, Uint32 num_read,
+                            SDL_GPUTexture *const *write, Uint32 num_write)
+{
+    return SDL_GPUNativeAccess(command_buffer, read, num_read, write, num_write, false);
+}
