+
+static void *VULKAN_GetNativeCommandBuffer(SDL_GPUCommandBuffer *commandBuffer)
+{
+    return (void *)((VulkanCommandBuffer *)commandBuffer)->commandBuffer;
+}
+
+// The layout a texture keeps between passes (VULKAN_INTERNAL_DefaultTextureUsageMode's).
+static VkImageLayout VULKAN_INTERNAL_DefaultTextureLayout(VulkanTexture *texture)
+{
+    switch (VULKAN_INTERNAL_DefaultTextureUsageMode(texture)) {
+    case VULKAN_TEXTURE_USAGE_MODE_SAMPLER:
+        return VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    case VULKAN_TEXTURE_USAGE_MODE_COLOR_ATTACHMENT:
+        return VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    case VULKAN_TEXTURE_USAGE_MODE_DEPTH_STENCIL_ATTACHMENT:
+        return VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    default:
+        return VK_IMAGE_LAYOUT_GENERAL;
+    }
+}
+
+// Every texture between its default layout and the native work's (read: shader read only;
+// write: general), with a full barrier either side: native work may use any stage.
+static bool VULKAN_NativeAccess(
+    SDL_GPUCommandBuffer *commandBuffer,
+    SDL_GPUTexture *const *read,
+    Uint32 numRead,
+    SDL_GPUTexture *const *write,
+    Uint32 numWrite,
+    bool begin)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanRenderer *renderer = vulkanCommandBuffer->renderer;
+    const Uint32 count = numRead + numWrite;
+    if (count == 0) {
+        return true;
+    }
+    VkImageMemoryBarrier *barriers = SDL_stack_alloc(VkImageMemoryBarrier, count);
+    for (Uint32 i = 0; i < count; i += 1) {
+        const bool writable = i >= numRead;
+        VulkanTexture *texture = ((VulkanTextureContainer *)(writable ? write[i - numRead] : read[i]))->activeTexture;
+        const VkImageLayout home = VULKAN_INTERNAL_DefaultTextureLayout(texture);
+        const VkImageLayout native = writable ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+        VkImageMemoryBarrier *barrier = &barriers[i];
+        barrier->sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        barrier->pNext = NULL;
+        barrier->srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier->dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier->oldLayout = begin ? home : native;
+        barrier->newLayout = begin ? native : home;
+        barrier->srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barrier->dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barrier->image = texture->image;
+        barrier->subresourceRange.aspectMask = texture->aspectFlags;
+        barrier->subresourceRange.baseMipLevel = 0;
+        barrier->subresourceRange.levelCount = texture->levelCount;
+        barrier->subresourceRange.baseArrayLayer = 0;
+        barrier->subresourceRange.layerCount = texture->layerCount;
+        if (begin) {
+            VULKAN_INTERNAL_TrackTexture(vulkanCommandBuffer, texture);
+        }
+    }
+    renderer->vkCmdPipelineBarrier(
+        vulkanCommandBuffer->commandBuffer,
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        0,
+        0,
+        NULL,
+        0,
+        NULL,
+        count,
+        barriers);
+    SDL_stack_free(barriers);
+    return true;
+}
