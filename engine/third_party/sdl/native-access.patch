+// Native access (TDKR patch)
+
+static bool METAL_GetNativeTexture(
+    SDL_GPURenderer *driverData,
+    SDL_GPUTexture *texture,
+    void **image,
+    void **view,
+    Uint32 *native_format)
+{
+    (void)driverData;
+    id<MTLTexture> handle = ((MetalTextureContainer *)texture)->activeTexture->handle;
+    if (image) {
+        *image = (__bridge void *)handle;
+    }
+    if (view) {
+        *view = NULL;
+    }
+    if (native_format) {
+        *native_format = (Uint32)handle.pixelFormat;
+    }
+    return true;
+}
+
+static void *METAL_GetNativeCommandBuffer(SDL_GPUCommandBuffer *commandBuffer)
+{
+    return (__bridge void *)((MetalCommandBuffer *)commandBuffer)->handle;
+}
+
+// Metal tracks the hazards itself: the textures are only kept alive with the command buffer.
+static bool METAL_NativeAccess(
+    SDL_GPUCommandBuffer *commandBuffer,
+    SDL_GPUTexture *const *read,
+    Uint32 numRead,
+    SDL_GPUTexture *const *write,
+    Uint32 numWrite,
+    bool begin)
+{
+    if (begin) {
+        MetalCommandBuffer *metalCommandBuffer = (MetalCommandBuffer *)commandBuffer;
+        for (Uint32 i = 0; i < numRead + numWrite; i += 1) {
+            SDL_GPUTexture *texture = i < numRead ? read[i] : write[i - numRead];
+            METAL_INTERNAL_TrackTexture(metalCommandBuffer, ((MetalTextureContainer *)texture)->activeTexture);
+        }
+    }
+    return true;
+}
